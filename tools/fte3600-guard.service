[Unit]
Description=FTE3600 Fingerprint Hardware & Driver Self-Healing Guard
Documentation=https://github.com/titan/fte3600-linux-driver
Before=fprintd.service basic.target
After=local-fs.target systemd-modules-load.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fte3600-guard
RemainAfterExit=yes
TimeoutSec=30

[Install]
WantedBy=sysinit.target multi-user.target
